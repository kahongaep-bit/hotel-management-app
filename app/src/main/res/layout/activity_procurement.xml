<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER NA BADILI PASSWORD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OFISI YA MANUNUZI (PROCUREMENT)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A202C" />

            <Button
                android:id="@+id/btnResetPassword"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔑 BADILI PASSWORD"
                android:textColor="#D69E2E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- VITUFE VYA PROFILES (2x2 GRID MPANGILIO SAHIHI) -->
        <!-- MSTARI WA 1: STOO KUU NA SUB-STORE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnViewStockBalance"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#4A5568"
                android:text="📦 Stoo Kuu"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnViewSubStore"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#3182CE"
                android:text="🏢 Sub-Store"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- MSTARI WA 2: + GRN NA RIPOTI ISSUE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnStockIn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#2F855A"
                android:text="+ GRN (Kuingiza)"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStockIssueReport"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#D69E2E"
                android:text="📊 Issue Report"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- TITLE BUTTON YA MSTATILI CHANI (KAMA TITLE YA MAOMBI) -->
        <Button
            android:id="@+id/btnPendingRequisitions"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#805AD5"
            android:text="📋 MAOMBI YANAYOSUBIRI IDHINI / YALIYORUDISHWA"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- ORODHA YA MAOMBI -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPendingRequisitions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>