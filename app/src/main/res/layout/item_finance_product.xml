<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF">

        <!-- TAARIFA ZA BIDHAA (JINA, KATEGORIA BADGE, NA BEI) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jina la Bidhaa"
                android:textColor="#1A202C"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <!-- Badge Ya Kategoria -->
                <TextView
                    android:id="@+id/tvProductCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aina: Vyakula"
                    android:textColor="#4A5568"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#EDF2F7"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TSH 0"
                    android:textColor="#2B6CB0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- VITUFE VYA HARIRI (EDIT) NA FUTA (DELETE) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProduct"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="HARIRI"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="#3182CE"
                android:textColor="#FFFFFF"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="14dp"
                app:iconTint="#FFFFFF"
                app:cornerRadius="6dp"
                android:layout_marginEnd="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProduct"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="FUTA"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="#E53E3E"
                android:textColor="#FFFFFF"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconSize="14dp"
                app:iconTint="#FFFFFF"
                app:cornerRadius="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>