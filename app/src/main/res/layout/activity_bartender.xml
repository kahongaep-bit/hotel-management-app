<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- HEADER / BAR COUNTER TITLE -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BAR COUNTER"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveBartender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bartender Zamu Hii: -"
                android:textColor="#38BDF8"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnResetPasswordBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:backgroundTint="#334155"
            android:text="🔑 Password"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- SEARCH BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etBarReceiptSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#F8FAFC"
            android:hint="Tafuta Token / Mteja"
            android:paddingStart="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnSearchDrinkOrder"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#EA580C"
            android:text="Tafuta"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- BUTTONS ROW: NUSU KWA NUSU (MAKABIDHIANO NA TAARIFA ZA MAUZO) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnMakabidhiano"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:text="📋 Makabidhiano"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBarSalesReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#059669"
            android:text="📊 Taarifa ya Mauzo"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Oda za Vinywaji Zinazosubiri:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- RECYCLER VIEW FOR DRINK ORDERS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDrinkItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>